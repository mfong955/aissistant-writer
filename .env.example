# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and keys from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── Encryption ────────────────────────────────────────────────────────────────
# Used to encrypt user OpenRouter API keys at rest.
# Generate with: openssl rand -hex 32
# CRITICAL: set this before any users add API keys. Changing it later invalidates stored keys.
ENCRYPTION_KEY=your-32-plus-character-random-secret

# ── AI (optional — only needed for credit-based users without their own key) ──
# Your own OpenRouter API key. Credit purchases pay for calls made through this key.
# Leave unset to disable the credits system and require users to bring their own key.
OPENROUTER_SYSTEM_API_KEY=sk-or-v1-...

# ── Stripe (optional — only needed for AI credit purchases) ───────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Dashboard → Webhooks → your endpoint → Signing secret
# Endpoint should receive: checkout.session.completed
# URL: https://your-domain.com/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
